# server
DEYE_HOST=127.0.0.1
DEYE_PORT=5000
DEYE_STALE_AFTER_SECONDS=20
# The flow diagram treats absolute powers at or below this value as idle.
DEYE_FLOW_DEADBAND_W=30
# Global freshness requires all listed fields to be fresh. Field freshness is
# always exposed independently in /api/state.
DEYE_FRESH_REQUIRED_FIELDS=solar.pv1_power_w,solar.pv2_power_w

# Delivery 3: snapshots complete and fresh, retained locally for a rolling day.
DEYE_HISTORY_DB_PATH=data/deye-monitor.sqlite3
DEYE_HISTORY_INTERVAL_SECONDS=5
DEYE_HISTORY_RETENTION_HOURS=24

# MQTT real (unused when DEYE_DATA_SOURCE=simulated)
DEYE_DATA_SOURCE=mqtt
DEYE_MQTT_HOST=localhost
DEYE_MQTT_PORT=1883
DEYE_MQTT_USERNAME=
DEYE_MQTT_PASSWORD=
DEYE_MQTT_TOPIC_PREFIX=deye
DEYE_MQTT_KEEPALIVE=30

# SG03LP1 topic suffixes. Leave optional topics blank until Delivery 0 confirms them.
DEYE_TOPIC_PV1=dc/pv1/power
DEYE_TOPIC_PV2=dc/pv2/power
DEYE_TOPIC_GRID_VOLTAGE=ac/l1/voltage
DEYE_TOPIC_GRID_ENERGY_BOUGHT=ac/daily_energy_bought
DEYE_TOPIC_GRID_ENERGY_SOLD=ac/daily_energy_sold
DEYE_TOPIC_INVERTER_AC_POWER=ac/total_power
DEYE_TOPIC_RADIATOR_TEMP=radiator_temp
DEYE_TOPIC_AC_TEMP=ac/temperature
DEYE_TOPIC_SERVICE_STATUS=status
DEYE_TOPIC_LOGGER_STATUS=logger_status

# Optional and deliberately disabled: validate a real topic and its sign first.
# Accepted grid signs: unknown, import_positive, export_positive.
DEYE_TOPIC_GRID_POWER=
DEYE_GRID_POWER_SIGN=unknown
# Accepted battery signs: unknown, charge_positive, discharge_positive.
DEYE_TOPIC_BATTERY_POWER=battery/power
DEYE_BATTERY_POWER_SIGN=charge_positive
DEYE_TOPIC_BATTERY_SOC=battery/soc
# UPS output / loads. Confirm the topic on the real inverter before enabling it.
DEYE_TOPIC_UPS_LOAD_POWER=

# simulated source only
DEYE_FIXTURE=fixtures/pv_production.json
DEYE_SIMULATED_INTERVAL_SECONDS=1
